generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
}

enum QuestAttemptStatus {
  active
  completed
  failed
  abandoned
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String
  passwordHash String?
  cefrLevel    CefrLevel @default(A1)
  xp           Int      @default(0)
  coins        Int      @default(0)
  streak       Int      @default(0)
  lastActiveAt DateTime @default(now())
  avatarConfig Json     @default("{}")
  placementDoneAt DateTime?
  reviewsDone  Int      @default(0)
  /// Learner's own language (BCP-47 from @es/shared LANGS); '' = not chosen yet (legacy users → vi).
  nativeLang   String   @default("")
  /// Small per-player game state: farm plots/basket, area quiz reward counters.
  gameState    Json     @default("{}")
  createdAt    DateTime @default(now())

  attempts QuestAttempt[]
  vocab    VocabEntry[]
}

model QuestAttempt {
  id          String             @id @default(cuid())
  userId      String
  questId     String
  npcId       String
  status      QuestAttemptStatus @default(active)
  score       Int?
  turns       Int                @default(0)
  goalsDone   String[]           @default([])
  transcript  Json               @default("[]")
  corrections Json               @default("[]")
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questId])
}

model VocabEntry {
  id           String   @id @default(cuid())
  userId       String
  word         String
  meaning      String
  /// Language of `meaning`.
  lang         String   @default("vi")
  example      String
  ease         Float    @default(2.5)
  intervalDays Int      @default(0)
  nextReviewAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, nextReviewAt])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  targetPlayerId String?
  targetName     String
  reason         String
  details        String   @default("")
  context        Json     @default("[]")
  createdAt      DateTime @default(now())

  @@index([targetPlayerId])
}

/// Product analytics (server + client events). Kept small: name + a few props.
model Event {
  id        String   @id @default(cuid())
  name      String
  playerId  String?
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

/// Beta feedback form.
model Feedback {
  id        String   @id @default(cuid())
  playerId  String?
  name      String
  text      String
  page      String   @default("")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
}

/// Device push tokens registered by the mobile app (FCM / APNs via FCM). Used by the reminder job.
model PushToken {
  token     String   @id
  playerId  String
  platform  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}
