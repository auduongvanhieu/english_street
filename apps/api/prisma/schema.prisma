generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
}

/// Admin site: editor = content only, admin = everything (players, settings).
enum UserRole {
  player
  editor
  admin
}

enum QuestAttemptStatus {
  active
  completed
  failed
  abandoned
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String
  passwordHash String?
  cefrLevel    CefrLevel @default(A1)
  xp           Int      @default(0)
  coins        Int      @default(0)
  /// 💎 gems: bought with money (top-ups) or a small gift; spent on gem items, extra NPC turns, or changed into coins
  gems         Int      @default(0)
  /// NPC turns bought with gems, used once the free daily turns are gone (they do not expire)
  npcBonusTurns Int     @default(0)
  streak       Int      @default(0)
  lastActiveAt DateTime @default(now())
  avatarConfig Json     @default("{}")
  placementDoneAt DateTime?
  reviewsDone  Int      @default(0)
  /// Learner's own language (BCP-47 from @es/shared LANGS); '' = not chosen yet (legacy users → vi).
  nativeLang   String   @default("")
  /// Small per-player game state: farm plots/basket, area quiz reward counters.
  gameState    Json     @default("{}")
  createdAt    DateTime @default(now())
  role         UserRole @default(player)
  /// Moderation: no sign-in / joining until this time (far future = permanent).
  bannedUntil  DateTime?
  banReason    String   @default("")
  /// No chat until this time.
  mutedUntil   DateTime?
  /// Bumped to sign the account out everywhere (tokens carry the version they were minted with).
  tokenVersion Int      @default(0)
  /// Admin site two-step sign-in (TOTP secret, base32); null = off.
  totpSecret   String?
  /// Last device the player joined with (DeviceInfo from @es/shared): model, OS, network…
  device       Json     @default("{}")
  /// IP address the player last joined from (POST /me/hello; admin site only).
  lastIp       String   @default("")
  /// Total time in the street (seconds), counted by the game server; per day in PlayDay.
  playSeconds  Int      @default(0)
  /// where the player was when they last left the street: { x, z, rot, at } (the game puts them back there)
  lastPos      Json?

  attempts QuestAttempt[]
  vocab    VocabEntry[]
}

model QuestAttempt {
  id          String             @id @default(cuid())
  userId      String
  questId     String
  npcId       String
  status      QuestAttemptStatus @default(active)
  score       Int?
  turns       Int                @default(0)
  goalsDone   String[]           @default([])
  transcript  Json               @default("[]")
  corrections Json               @default("[]")
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questId])
}

model VocabEntry {
  id           String   @id @default(cuid())
  userId       String
  word         String
  meaning      String
  /// Language of `meaning`.
  lang         String   @default("vi")
  example      String
  ease         Float    @default(2.5)
  intervalDays Int      @default(0)
  nextReviewAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, nextReviewAt])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  targetPlayerId String?
  targetName     String
  reason         String
  details        String   @default("")
  context        Json     @default("[]")
  createdAt      DateTime @default(now())
  /// new | done | ignored
  status         String   @default("new")
  handledBy      String?
  handledAt      DateTime?
  note           String   @default("")

  @@index([targetPlayerId])
  @@index([status, createdAt])
}

/// Product analytics (server + client events). Kept small: name + a few props.
model Event {
  id        String   @id @default(cuid())
  name      String
  playerId  String?
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

/// Beta feedback form.
model Feedback {
  id        String   @id @default(cuid())
  playerId  String?
  name      String
  text      String
  page      String   @default("")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  /// new | done
  status    String   @default("new")
}

/// Device push tokens registered by the mobile app (FCM / APNs via FCM). Used by the reminder job.
model PushToken {
  token     String   @id
  playerId  String
  platform  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

/// Admin actions (who changed what), for review and undo.
model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  target    String   @default("")
  before    Json?
  after     Json?
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

/// Content edited in the admin site. Overrides the YAML in packages/quests/content (kind + id).
/// kinds: npc, quest, pair, placement, area, area-tr (id = language), world.
model ContentDoc {
  kind      String
  id        String
  data      Json
  /// true = the YAML item is hidden/removed.
  deleted   Boolean  @default(false)
  version   Int      @default(1)
  updatedBy String
  updatedAt DateTime @updatedAt

  @@id([kind, id])
}

model ContentRevision {
  id        String   @id @default(cuid())
  kind      String
  docId     String
  version   Int
  data      Json?
  deleted   Boolean  @default(false)
  updatedBy String
  createdAt DateTime @default(now())

  @@index([kind, docId, createdAt])
}

/// Live settings (anti-spam limits, budget, maintenance…). Unset keys fall back to .env.
model Setting {
  key       String   @id
  value     Json
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt
}

/// Invite codes for the closed beta (in addition to BETA_CODES in .env).
model BetaCode {
  code      String   @id
  label     String   @default("")
  uses      Int      @default(0)
  maxUses   Int?
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Banner / in-game notice for everyone, between startsAt and endsAt.
model Announcement {
  id        String   @id @default(cuid())
  text      String
  /// info | warning
  level     String   @default("info")
  startsAt  DateTime @default(now())
  endsAt    DateTime
  createdBy String
  createdAt DateTime @default(now())

  @@index([endsAt])
}

/// Player positions sampled by the game server, counted per 4 m cell and hour (heat map).
model HeatCell {
  hour  DateTime
  cx    Int
  cz    Int
  count Int

  @@id([hour, cx, cz])
  @@index([hour])
}

/// Daily rollups for the stats pages (one row per day + metric + key).
model DailyStat {
  day    String
  metric String
  key    String @default("")
  value  Float

  @@id([day, metric, key])
  @@index([metric, day])
}

/// Friends: one row per pair of players (account or guest ids, aId < bId so a pair has one row).
/// No foreign keys: guests may not have a User row yet.
model Friendship {
  id        String       @id @default(cuid())
  aId       String
  bId       String
  /// Display names at the time of the request / acceptance (guests choose a name per visit).
  aName     String       @default("")
  bName     String       @default("")
  /// Who sent the request.
  requester String
  status    FriendStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([aId, bId])
  @@index([bId])
}

enum FriendStatus {
  pending
  accepted
}

/// Time in the street per player and day (Vietnam day, UTC+7): seconds online and sessions started.
model PlayDay {
  userId   String
  day      String
  seconds  Int    @default(0)
  sessions Int    @default(0)

  @@id([userId, day])
  @@index([day])
}

/// Claude API use per Vietnam day (UTC+7), what it was for and model: tokens and estimated USD (admin "Claude AI").
/// purpose: npc_turn | pair_judge | word_translate | content_translate; detail: npc/quest id or language.
model LlmUsage {
  day        String
  purpose    String
  detail     String @default("")
  model      String
  requests   Int    @default(0)
  input      Int    @default(0)
  output     Int    @default(0)
  cacheRead  Int    @default(0)
  cacheWrite Int    @default(0)
  usd        Float  @default(0)

  @@id([day, purpose, detail, model])
  @@index([day])
}

/// Every change of User.coins or User.gems (one row per change): rewards, spending, top-ups, refunds, admin fixes.
/// currency: coin | gem; reason: reward | spend | purchase | refund | admin | transfer | exchange;
/// source: what for (taxi, quiz, myfarm, npc_turns…); ref: order code etc.
model CoinLedger {
  id           String   @id @default(cuid())
  userId       String
  currency     String   @default("coin")
  delta        Int
  balanceAfter Int
  reason       String
  source       String   @default("")
  ref          String   @default("")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

/// A top-up: the player picked a gem pack and a way to pay. amount is in the smallest unit: đồng (vnd) or
/// micro-USDT (usdt_trc20 / usdt_bep20, 1 USDT = 1 000 000). code: the transfer content (vnd) / order id shown.
/// status: pending | paid | expired | cancelled | refunded
model PaymentOrder {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  pack       String
  gems       Int
  method     String
  amount     Int
  status     String    @default("pending")
  paidAmount Int       @default(0)
  txRef      String?   @unique
  note       String    @default("")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  paidAt     DateTime?

  @@index([userId, createdAt])
  @@index([status, method])
}

/// Every incoming transfer seen (SePay webhook, TRC20 / BEP20 scan), matched to an order or waiting for an admin.
/// source: sepay | trc20 | bep20; amount in the same unit as PaymentOrder.amount; status: matched | unmatched | manual | ignored
model PaymentTx {
  id        String   @id @default(cuid())
  source    String
  txRef     String
  amount    Int
  content   String   @default("")
  orderCode String?
  status    String
  raw       Json     @default("{}")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([source, txRef])
  @@index([status, createdAt])
}
