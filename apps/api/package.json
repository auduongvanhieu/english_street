{
  "name": "@es/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/journey/engine.test.ts src/journey/myfarm.test.ts src/journey/teamgames.test.ts src/npc/notEnglish.test.ts",
    "test:db": "tsx src/npc/ledger.dbtest.ts && tsx src/payments/payments.dbtest.ts && tsx src/gems/gems.dbtest.ts",
    "prisma": "prisma",
    "postinstall": "prisma generate",
    "eval:npc": "tsx scripts/npc-eval.ts",
    "eval:pair": "tsx scripts/pair-eval.ts",
    "i18n:translate": "tsx scripts/i18n-translate.ts",
    "i18n:check": "tsx scripts/i18n-translate.ts --check",
    "admin:grant": "tsx scripts/admin-grant.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "playtime:backfill": "tsx scripts/playtime-backfill.ts",
    "db:restore": "tsx scripts/db-backup.ts restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@es/quests": "workspace:*",
    "@es/shared": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "geoip-country": "^5.0.202611040312",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "7.10.1",
    "typescript": "^5.9.0"
  }
}
