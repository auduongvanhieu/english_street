{
  "name": "@es/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "postinstall": "prisma generate",
    "eval:npc": "tsx scripts/npc-eval.ts",
    "eval:pair": "tsx scripts/pair-eval.ts",
    "i18n:translate": "tsx scripts/i18n-translate.ts",
    "i18n:check": "tsx scripts/i18n-translate.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@es/quests": "workspace:*",
    "@es/shared": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "7.10.1",
    "typescript": "^5.9.0"
  }
}
