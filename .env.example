# --- Database ---
DATABASE_URL=postgresql://es:es@localhost:5432/english_street
REDIS_URL=redis://localhost:6379

# --- Servers ---
API_PORT=4000
GAME_PORT=2567
WEB_ORIGIN=http://localhost:5173

# --- Client (Vite exposes only VITE_* vars) ---
VITE_API_URL=http://localhost:4000
VITE_GAME_WS_URL=ws://localhost:2567

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
NPC_MODEL=claude-opus-5-5
# claude | mock | auto  (auto = claude when a real key is set, otherwise a local mock NPC for development)
NPC_PROVIDER=auto
NPC_RATE_PER_MIN=20

# --- Cost control ---
NPC_MODEL_BASIC=claude-haiku-5-5   # A1–A2 quests + free chat; B1+ use NPC_MODEL
NPC_DAILY_TURNS_PER_PLAYER=60
NPC_DAILY_BUDGET_USD=5
NPC_HISTORY_MAX=10

# --- Auth ---
AUTH_SECRET=change-me-to-a-long-random-string

# --- Production / deploy (see docs/DEPLOY.md) ---
# NODE_ENV=production            # refuses the default AUTH_SECRET
# TRUST_PROXY=true               # behind Caddy/nginx so per-IP limits see the real client address
ADMIN_TOKEN=                     # bearer token for GET /admin/stats, /admin/budget, /admin/reports, /admin/feedback
BETA_CODES=                      # closed beta: comma-separated invite codes (empty = open to everyone)
# Domains for infra/docker-compose.prod.yml
WEB_DOMAIN=play.example.com
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me

# Cloudflare Turnstile for sign-in / sign-up (empty = built-in image captcha)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# "Forgot password" e-mails a 6-digit code. Either SMTP (Gmail: smtp.gmail.com, 465, the address, an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ... or Resend (https://resend.com, sender on a verified domain). Neither set = "Forgot password" says mail is off.
RESEND_API_KEY=
# Sender; with SMTP and no MAIL_FROM the SMTP address is used.
# MAIL_FROM=English Street <no-reply@englishstreet.coffeesos.online>
# Anti-spam: guests playing at once per IP (game server), guest passes per IP per hour / day (API)
MAX_GUESTS_PER_IP=6
GUEST_PASSES_PER_IP_HOUR=10
GUEST_PASSES_PER_IP_DAY=30
# Production behind nginx: listen on localhost only
BIND_HOST=0.0.0.0

# Admin site (/admin/): give an account access with  pnpm --filter @es/api admin:grant <email> admin|editor
# The API and the game server call each other on localhost (ports above); override if they run elsewhere:
# GAME_INTERNAL_URL=http://127.0.0.1:2567
# API_INTERNAL_URL=http://127.0.0.1:4000
# Most limits above can also be changed live in the admin site (Settings); .env values are the defaults.
