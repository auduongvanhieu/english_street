# --- Database ---
DATABASE_URL=postgresql://es:es@localhost:5432/english_street
REDIS_URL=redis://localhost:6379

# --- Servers ---
API_PORT=4000
GAME_PORT=2567
WEB_ORIGIN=http://localhost:5173

# --- Client (Vite exposes only VITE_* vars) ---
VITE_API_URL=http://localhost:4000
VITE_GAME_WS_URL=ws://localhost:2567

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
NPC_MODEL=claude-opus-5-5
# claude | mock | auto  (auto = claude when a real key is set, otherwise a local mock NPC for development)
NPC_PROVIDER=auto
NPC_RATE_PER_MIN=20

# --- Cost control ---
NPC_MODEL_BASIC=claude-haiku-5-5   # A1–A2 quests + free chat; B1+ use NPC_MODEL
NPC_DAILY_TURNS_PER_PLAYER=60
NPC_DAILY_BUDGET_USD=5
NPC_HISTORY_MAX=10

# --- Auth ---
AUTH_SECRET=change-me-to-a-long-random-string
